# Copia a .env (no se commitea). Todo es explícito: el entorno nunca se infiere.
# BETA o PRODUCTION. Se muestra en GET /health.
BILLING_ENV=BETA
# Token de servicio que debe presentar desertica-api (mínimo 32 caracteres).
# Genera uno con: php -r 'echo bin2hex(random_bytes(32)), PHP_EOL;'
BILLING_SERVICE_TOKEN=
# fake = FakeSunatGateway (sin red). greenter = SUNAT real (beta o producción según BILLING_ENV).
BILLING_GATEWAY=fake
# IMMEDIATE (cada boleta a SUNAT al emitir) o DAILY_SUMMARY (resumen diario). Ver docs/DECISIONS.md.
BILLING_BOLETA_SUBMISSION=IMMEDIATE
BILLING_STORAGE_DIR=var/storage
# DSN de PDO. Por defecto SQLite dentro de BILLING_STORAGE_DIR.
# BILLING_DB_DSN=sqlite:var/storage/billing.sqlite
# Solo con BILLING_GATEWAY=greenter. Certificado .pfx/.p12 o .pem montado como secreto; nunca en el repo.
BILLING_CERT_PATH=
BILLING_CERT_PASSWORD=
BILLING_SOL_USER=
BILLING_SOL_PASSWORD=
# Emisor. En PRODUCTION todas las BILLING_ISSUER_* son obligatorias, sin RUC de prueba ni datos de ejemplo. En BETA, SUNAT solo acepta el RUC de pruebas 20000000001 con las credenciales públicas de prueba de la guía de Greenter (no se copian aquí).
BILLING_ISSUER_RUC=20000000001
BILLING_ISSUER_LEGAL_NAME=DESERTICA SAC
BILLING_ISSUER_TRADE_NAME=DESERTICA
BILLING_ISSUER_ADDRESS=-
BILLING_ISSUER_UBIGEO=150101
BILLING_ISSUER_DEPARTMENT=LIMA
BILLING_ISSUER_PROVINCE=LIMA
BILLING_ISSUER_DISTRICT=LIMA
BILLING_ISSUER_LOCAL_CODE=0000

# --- Decisiones del contador (docs/DECISIONS.md, «Decisiones del contador»). Los valores por defecto son los más restrictivos.
# Unidad de medida (catálogo 03) de todas las líneas.
BILLING_UNIT_CODE=NIU
# true añade la leyenda 2004 «Agencia de Viaje – Paquete turístico» a boletas y facturas.
BILLING_LEGEND_2004=false
# Boletas en PEN por este monto (céntimos, IGV incluido) o menos pueden omitir el receptor. 0 = receptor siempre obligatorio.
# El tope legal debe confirmarlo el contador; no lo asumas.
BILLING_ANONYMOUS_BOLETA_MAX_CENTS=0

# --- Consulta de CDR (getStatusCdr) para recuperar un envío cuya respuesta se perdió.
# Por defecto: el servicio de producción de SUNAT en PRODUCTION y desactivada en BETA ("-" la desactiva explícitamente).
# BILLING_CDR_CONSULT_URL=https://e-factura.sunat.gob.pe/ol-it-wsconscpegem/billConsultService
# Códigos de excepción de SUNAT (4 dígitos, separados por comas) que significan «comprobante ya registrado». Sin verificar contra SUNAT.
# BILLING_ALREADY_REGISTERED_CODES=1033
# CA adicional (archivo PEM) si la cadena de SUNAT no valida con el almacén del sistema. La verificación TLS nunca se apaga.
# BILLING_SUNAT_CA_FILE=

