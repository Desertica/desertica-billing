<?xml version="1.0"?>
<ruleset name="desertica-billing">
    <description>PSR-12</description>
    <file>src</file>
    <file>tests</file>
    <file>public</file>
    <file>bin</file>
    <arg name="colors"/>
    <arg name="cache" value=".phpcs-cache"/>
    <rule ref="PSR12"/>
    <rule ref="Generic.Files.LineLength">
        <properties>
            <property name="lineLimit" value="180"/>
            <property name="absoluteLineLimit" value="0"/>
        </properties>
    </rule>
</ruleset>
